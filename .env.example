# Email export (optional — the app works download-only without these).
# Get an API key at https://resend.com. Verify the sending domain first.
RESEND_API_KEY=

# Verified sender address, for example: notes@yourpractice.com
EMAIL_FROM=

# THE fixed corporate recipient. Notes can never be emailed anywhere else.
CORPORATE_EMAIL=

# Optional shared access code. When set, every send requires the same code
# entered in the app (sent as the x-access-code header).
ACCESS_CODE=

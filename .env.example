# --- Auth (required) ---
# A long random string. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Authenticator-app two-factor sign-in. OFF unless set to 1. Leave off until
# the practice has a second Developer or working reset email — with only one
# Developer, a lost phone locks the whole site with nobody left to reset it.
# While off, login never asks for codes and stale enrollments are cleared at
# boot so re-enabling starts clean.
MFA_ENABLED=

# --- First admin bootstrap (optional) ---
# If set and the users table is empty, this admin is created on first boot.
# Otherwise, open /setup to create the first admin in the browser.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# One-shot recovery: when set to 1, the next boot resets ADMIN_USERNAME's
# password to ADMIN_PASSWORD and clears any authenticator-app second factor
# (Developer accounts only) — the full lockout kit, since an owner locked out
# by MFA is just as stuck as one locked out by a lost password. Remove this
# flag immediately after you can sign in again — leaving it on rewrites the
# credentials on every cold start.
ADMIN_PASSWORD_RESET=

# --- Database ---
# Production: set POSTGRES_URL to a Vercel Postgres / Neon connection string.
# Local/dev/tests: leave POSTGRES_URL unset to use in-process PGlite.
POSTGRES_URL=
# Where PGlite stores data when POSTGRES_URL is unset (ignored in tests).
# On Vercel without POSTGRES_URL the app uses /tmp/smile-notes-pglite automatically
# (the only writable path); that data does NOT survive cold starts — set POSTGRES_URL.
PGLITE_DIR=.data/pglite

# --- AI assist (optional; the app is fully functional without it) ---
# Both must be set for AI features to appear. Calls run server-side only,
# after the PHI gate, and every output is verified against the input for
# changed numbers, negations, drugs, teeth, and attributions.
# Get a key at https://vercel.com/ai-gateway (or use any AI Gateway key).
ASSIST_ENABLED=
AI_GATEWAY_API_KEY=
# Model routed through the gateway. Default: anthropic/claude-sonnet-4.5
ASSIST_MODEL=

# --- Email export (optional; app works and files tickets without it) ---
# Get an API key at https://resend.com and verify the sending domain first.
RESEND_API_KEY=
# Verified sender, e.g. notes@yourpractice.com
EMAIL_FROM=
# THE fixed corporate recipient. Notes can never be emailed anywhere else.
CORPORATE_EMAIL=

# --- ByteStar pioneer advisor (rides the assist switch above) ---
# Open whenever assist is on. Set to 0 to close the pioneer path while the
# rest of assist stays up (pre-go-live posture: no separate activation).
# One-way and read-only: staff cannot prompt it; PHI gate + escape backstops
# + meaning verifier run on every call.
BYTESTAR_ENABLED=
# Optional model override; defaults to ASSIST_MODEL.
BYTESTAR_MODEL=
# SILENT KILLSWITCH. When set to 1, ByteStar is unavailable. Never named in
# prompts or end-user chrome. Team Lead monitor can see that it is engaged.
BYTESTAR_KILL=
# Self-consistency reads (1-3, default 1). At 2 or 3, the draft is read
# independently that many times and only observations a MAJORITY of reads
# agree on survive — the honest hallucination filter, at N× the call cost.
BYTESTAR_READS=

# Weekly legal-watch alert cron (vercel.json calls /api/law-watch/alert).
# Any long random string; the endpoint refuses everything without it.
CRON_SECRET=

# Voice dictation posture. Set to 1 to remove the dictation button entirely —
# for a deployment whose compliance review rejects the browser speech engine
# (audio may be processed off-device). See docs/voice-dictation-architecture.md.
NEXT_PUBLIC_DICTATION_DISABLED=

# --- Electronic dental record (EDR) product name ---
# Smile Notes writes the de-identified body; the practice charting system
# stamps identity and dates. Default display name is "Curve Hero". Set these
# when deploying beside a different PMS — no sync adapter required.
# Server + AI prompts:
EDR_PRODUCT_NAME=
EDR_PRODUCT_SHORT=
# Client UI (Copy button, Risk checklist). Prefer the same values as above.
NEXT_PUBLIC_EDR_PRODUCT_NAME=
NEXT_PUBLIC_EDR_PRODUCT_SHORT=
